{
	"name": "pg-listen-reconnect",
	"version": "0.0.0",
	"description": "Postgres LISTEN/NOTIFY for the pg driver that stays subscribed: reconnects with backoff, re-runs LISTEN, detects half-open connections and tells you when to re-sync. A drop-in replacement for pg-listen",
	"license": "MIT",
	"author": "Ankur Dubey (https://github.com/RagedPanda)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RagedPanda/pg-listen-reconnect.git"
	},
	"type": "module",
	"main": "./dist/cjs/index.js",
	"types": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/**/*.test.ts\"",
		"coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.ts\"",
		"bench": "node bench/index.ts",
		"prepublishOnly": "npm run typecheck && npm test && npm run build"
	},
	"keywords": [
		"postgres",
		"postgresql",
		"pg",
		"listen",
		"notify",
		"pg-listen",
		"pubsub",
		"pub-sub",
		"notifications",
		"reconnect",
		"node-postgres"
	],
	"peerDependencies": {
		"@types/pg": "^8.6.0",
		"pg": "^8.7.0"
	},
	"peerDependenciesMeta": {
		"@types/pg": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/pg": "8.23.1",
		"pg": "8.23.1",
		"pg-listen": "1.7.0",
		"typescript": "^7.0.2"
	}
}
